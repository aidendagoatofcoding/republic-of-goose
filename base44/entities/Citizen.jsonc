{
  "name": "Citizen",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Citizen's full name as entered on the register"
    },
    "goose_name": {
      "type": "string",
      "description": "Chosen national Goose name"
    },
    "username": {
      "type": "string",
      "description": "Unique citizen username used to sign in"
    },
    "password_hash": {
      "type": "string",
      "description": "Hashed citizen password, never shown to anyone"
    },
    "password_salt": {
      "type": "string",
      "description": "Random salt used to hash the citizen password"
    },
    "species": {
      "type": "string",
      "description": "Species of the citizen: goose, fox, squirrel, turtle, anteater, hummingbird or marlin"
    },
    "district": {
      "type": "string",
      "description": "District of residence inside the Republic"
    },
    "honkish_level": {
      "type": "string",
      "description": "Self-declared HONKISH proficiency"
    },
    "email": {
      "type": "string",
      "description": "Optional contact address for official correspondence"
    },
    "oath_accepted": {
      "type": "boolean",
      "description": "Whether the Citizen's Oath was accepted at registration"
    },
    "ip_address": {
      "type": "string",
      "description": "Network address the registration came from, used to admit one citizen per address"
    },
    "passport_code": {
      "type": "string",
      "description": "Private passport code the citizen uses to sign in"
    },
    "avatar_url": {
      "type": "string",
      "description": "Uploaded portrait shown beside the citizen in the Honk Hall"
    },
    "bread": {
      "type": "number",
      "description": "Bread balance held by the citizen"
    },
    "decorations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Shop items owned by the citizen, worn on their animal"
    },
    "workers": {
      "type": "number",
      "description": "Bakery hands hired by the citizen, each baking bread automatically"
    },
    "last_baked": {
      "type": "string",
      "description": "Timestamp of the last collection from hired bakery hands"
    },
    "last_chat_reward": {
      "type": "string",
      "description": "Timestamp of the last chat bread reward, used for the cooldown"
    }
  },
  "required": [
    "full_name",
    "district",
    "honkish_level"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}