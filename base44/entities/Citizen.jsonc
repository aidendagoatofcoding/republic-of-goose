{
  "name": "Citizen",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Citizen's full name as entered on the register"
    },
    "goose_name": {
      "type": "string",
      "description": "Chosen national Goose name"
    },
    "username": {
      "type": "string",
      "description": "Unique citizen username used to sign in"
    },
    "password_hash": {
      "type": "string",
      "description": "Hashed citizen password, never shown to anyone"
    },
    "password_salt": {
      "type": "string",
      "description": "Random salt used to hash the citizen password"
    },
    "species": {
      "type": "string",
      "description": "Species of the citizen: goose, fox, squirrel, turtle, anteater, hummingbird or marlin"
    },
    "district": {
      "type": "string",
      "description": "District of residence inside the Republic"
    },
    "honkish_level": {
      "type": "string",
      "description": "Self-declared HONKISH proficiency"
    },
    "email": {
      "type": "string",
      "description": "Optional contact address for official correspondence, also used to sign in with Google"
    },
    "auth_user_id": {
      "type": "string",
      "description": "Google account identity linked to this passport"
    },
    "oath_accepted": {
      "type": "boolean",
      "description": "Whether the Citizen's Oath was accepted at registration"
    },
    "ip_address": {
      "type": "string",
      "description": "Network address the registration came from, used to admit one citizen per address"
    },
    "passport_code": {
      "type": "string",
      "description": "Private passport code the citizen uses to sign in"
    },
    "avatar_url": {
      "type": "string",
      "description": "Uploaded portrait shown beside the citizen in the Honk Hall"
    },
    "bread": {
      "type": "number",
      "description": "Bread balance held by the citizen"
    },
    "bread_earned": {
      "type": "number",
      "description": "Total bread earned through work, baking and chat, used to unlock better jobs"
    },
    "xp": {
      "type": "number",
      "description": "Lifetime experience earned in the arena and at the Champion Isle games"
    },
    "sword_tier": {
      "type": "number",
      "description": "Which blade the citizen carries: 0 rusty through 4 Honkbringer"
    },
    "decorations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Shop items owned by the citizen, worn on their animal"
    },
    "possessions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Homes, vehicles, pets and furniture bought by the citizen"
    },
    "world_spots": {
      "type": "array",
      "description": "Where the citizen's home, vehicle, pets and items sit in the Honk Commons",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    },
    "home_items": {
      "type": "array",
      "description": "Furniture set out inside the citizen's own home, placed on the floor plan",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    },
    "workers": {
      "type": "number",
      "description": "Bakery hands hired by the citizen, each baking bread automatically"
    },
    "last_baked": {
      "type": "string",
      "description": "Timestamp of the last collection from hired bakery hands"
    },
    "last_chat_reward": {
      "type": "string",
      "description": "Timestamp of the last chat bread reward, used for the cooldown"
    },
    "job": {
      "type": "string",
      "description": "National job held by the citizen, paid in bread while the site is open"
    },
    "last_wage": {
      "type": "string",
      "description": "Timestamp of the last wage paid out for the citizen's job"
    }
  },
  "required": [
    "full_name",
    "district",
    "honkish_level"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}