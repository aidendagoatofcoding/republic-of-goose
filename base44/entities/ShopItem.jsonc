{
  "name": "ShopItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the item sold in the e-shop"
    },
    "emoji": {
      "type": "string",
      "description": "Emoji shown for the item, and worn or placed in the Commons"
    },
    "price": {
      "type": "number",
      "description": "Price in bread"
    },
    "description": {
      "type": "string",
      "description": "Short shop description"
    },
    "category": {
      "type": "string",
      "enum": [
        "decoration",
        "home",
        "vehicle",
        "pet"
      ],
      "default": "decoration",
      "description": "Kind of purchase: a worn decoration, a home, a vehicle or a pet"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}